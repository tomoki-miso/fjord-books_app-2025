<div id="<%= dom_id report %>">
  <p>
    <strong><%= Report.human_attribute_name(:user) %>:</strong>
    <% if report.user.name.presence %>
      <%= report.user.name %>
    <% else %>
      <%= report.user.email %>
    <% end %>
  </p>
  <p>
    <strong><%= Report.human_attribute_name(:title) %>:</strong>
    <%= report.title %>
  </p>
  <p>
    <strong><%= Report.human_attribute_name(:content) %>:</strong>
    <%= report.content %>
  </p>
  <p>
    <strong><%= Report.human_attribute_name(:time_stamp) %>:</strong>
    <%= report.created_at.strftime("%Y年%m月%d日") %>
  </p>
</div>
