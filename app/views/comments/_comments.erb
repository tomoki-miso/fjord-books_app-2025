<h2><%= Comment.model_name.human(count: :many) %></h2>
<% unless commentable.comments.present? %>
  <p id="no_comments_found"><%= t('views.common.no_items_found', name: Comment.model_name.human(count: :many)) %></p>
<% end %>
<div id="comments_list" class="index-items">
    <% commentable.comments.each do |comment| %>
      <%= render comment %>
    <% end %>
</div>