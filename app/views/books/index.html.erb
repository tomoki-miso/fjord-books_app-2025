<p style="color: green"><%= notice %></p>

<% content_for :title, t('views.common.list.title',name: t('activerecord.models.book')) %>

<h1><%= t('views.common.list.title', name: t('activerecord.models.book')) %></h1>

<div id="books">
  <% @books.each do |book| %>
    <%= render book %>
    <p>
      <%= link_to t('views.common.show', name: t('activerecord.models.book')), book %>
    </p>
  <% end %>
</div>

<%= link_to t('views.common.new.title', name: t('activerecord.models.book')), new_book_path %>
