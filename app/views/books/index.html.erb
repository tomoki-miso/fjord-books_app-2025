<p style="color: green"><%= notice %></p>

<% content_for :title, t('index.books') %>

<h1><%= t('index.books') %></h1>

<div id="books">
  <% @books.each do |book| %>
    <%= render book %>
    <p>
      <%= link_to t('common.show_this_book'), book %>
    </p>
  <% end %>
</div>

<%= link_to t('common.new_book'), new_book_path %>
