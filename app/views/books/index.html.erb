<p style="color: green"><%= notice %></p>

<% content_for :title, t('views.common.list.title',name: Book.model_name.human) %>

<h1><%= t('views.common.list.title', name: Book.model_name.human) %></h1>

<div id="books">
  <% @books.each do |book| %>
    <%= render book %>
    <p>
      <%= link_to t('views.common.show', name: Book.model_name.human), book %>
    </p>
  <% end %>
</div>

<%= link_to t('views.common.new.title', name: Book.model_name.human), new_book_path %>
