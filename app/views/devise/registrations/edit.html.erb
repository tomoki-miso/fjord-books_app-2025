<h2><%= t('views.user.edit_profile') %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <p><%= f.label :email %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="field">
    <p><%= f.label :password %> <i><%= t('views.user.leave_blank') %> </i></p>
    <p><%= f.password_field :password, autocomplete: "new-password" %></p>
    <% if @minimum_password_length %>
      <p><em><%= @minimum_password_length %> characters minimum</em></p>
    <% end %>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :current_password %> <i><%= t('views.user.confirm_password') %></i></p>
    <p><%= f.password_field :current_password, autocomplete: "current-password" %></p>
  </div>

    <div class="field">
    <p><%= f.label :post_code %></p>
    <p><%= f.text_field :post_code, autocomplete: "postal-code" %></p>
  </div>

  <div class="field">
    <p><%= f.label :address %></p>
    <p><%= f.text_field :address, autocomplete: "street-address" %></p>
  </div>

  <div class="field">
    <p><%= f.label :bio %></p>
    <p><%= f.text_area :bio %></p>
  </div>

  <div class="actions">
    <%= f.submit t('helpers.submit.update') %>
  </div>
<% end %>

<h3><%= t('views.user.cancel_my_account') %></h3>

<div><%= t('views.user.unhappy') %> <%= button_to t('views.user.cancel_my_account'), registration_path(resource_name), data: { confirm: t('views.common.delete_confirm'), turbo_confirm: t('views.common.delete_confirm') }, method: :delete %></div>

<%= link_to t('views.common.back', name: i18n_pluralize(Book.model_name.human.downcase)), :back %>
